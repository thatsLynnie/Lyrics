LYRICS_SECRET_KEY=replace-with-a-long-random-value
# development (default) or production. Production requires a fixed LYRICS_SECRET_KEY,
# marks the session cookie as Secure (HTTPS only) and never enables the debugger.
LYRICS_ENV=development
# Set to 1 to enable the Werkzeug debugger locally. Ignored when LYRICS_ENV=production.
LYRICS_DEBUG=0
# Set to 1 only when running behind a trusted proxy (Netlify, Nginx...) so rate limits use the real client IP.
LYRICS_TRUST_PROXY=0
# Optional: creates this administrator on startup if the email does not exist yet (password 12+ characters).
LYRICS_ADMIN_EMAIL=
LYRICS_ADMIN_PASSWORD=
LYRICS_DB_BACKEND=mysql
LYRICS_MYSQL_HOST=127.0.0.1
LYRICS_MYSQL_PORT=3306
LYRICS_MYSQL_USER=root
LYRICS_MYSQL_PASSWORD=
LYRICS_MYSQL_DATABASE=lyrics
LYRICS_UPLOADS=uploads
LYRICS_AI_ASSISTANT_NAME=Asistente musical
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LYRICS_AI_DAILY_LIMIT=40
# Seconds to wait for the AI provider (5-60). Use 20 behind Netlify, whose proxy cuts requests at 26 s.
LYRICS_AI_TIMEOUT=35
